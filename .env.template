# Токен Discord бота
DISCORD_TOKEN=ваш_токен

# ID клиента (приложения)
CLIENT_ID=ваш_id

# Ключ для шифрования токенов Яндекс в базе данных (любая длинная случайная строка)
# Сгенерировать можно так: openssl rand -hex 32
ENCRYPTION_KEY=ваш_секретный_ключ

#Юзеры, которые могут использовать все команды, независимо от прав на сервере.
#Лучше указывать Discord ID: username может смениться. Несколько значений — через запятую
ADMINS=ваш_discord_id

#Каталог базы пользователей. По умолчанию data/ в папке проекта, в Docker — /app/data.
#Укажите, если постоянное хранилище платформы подключено по другому пути
#DATA_DIR=/data

#Уровень логов: debug, info, warn, error или silent. Если не задан: debug при DEBUG=true, иначе info
#LOG_LEVEL=info

#Цвет уровней в логах: true или false. Если не задан, цвет есть только при выводе в терминал.
#В Docker-образе включён: консоль логов Portainer его показывает
#LOG_COLORS=true

#Для прода нужно ставить FALSE
#DEBUG=true
