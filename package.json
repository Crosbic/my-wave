{
  "name": "ym-player-bot",
  "version": "0.6.1",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "deploy": "tsx src/deploy-commands.ts",
    "typecheck": "tsc --noEmit && tsc -p test",
    "test": "node --import tsx --import ./test/setup.ts --test \"test/**/*.test.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "openapi-typescript https://raw.githubusercontent.com/acherkashin/yandex-music-open-api/main/src/yandex-music.yaml -o src/types/yandex-api.d.ts",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.12",
    "axios": "^1.21.0",
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.18.0",
    "dotenv": "^16.3.1",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.13",
    "opusscript": "^0.1.1",
    "undici": "^6.27.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-typescript": "^3.8.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-unused-imports": "^4.1.4",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.5.3",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  }
}
